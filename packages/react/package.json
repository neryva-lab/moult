{
  "name": "@moult/react",
  "version": "0.1.1",
  "description": "React adapter for committed, generation-scoped Moult contributions.",
  "keywords": [
    "react",
    "react-hooks",
    "adapter",
    "plugin-runtime",
    "lifecycle"
  ],
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/neryva-lab/moult.git",
    "directory": "packages/react"
  },
  "bugs": {
    "url": "https://github.com/neryva-lab/moult/issues"
  },
  "homepage": "https://github.com/neryva-lab/moult#readme",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.cjs",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint . && prettier --check .",
    "test": "vitest run --config vitest.config.ts",
    "build": "tsdown",
    "api-extract": "api-extractor run --local"
  },
  "peerDependencies": {
    "@moult/runtime": "workspace:*",
    "react": ">=18"
  },
  "devDependencies": {
    "@microsoft/api-extractor": "^7.59.0",
    "@moult/runtime": "workspace:*",
    "@moult/test": "workspace:*",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tsdown": "^0.22.14"
  }
}
