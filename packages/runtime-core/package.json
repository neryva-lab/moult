{
  "name": "@moult/runtime",
  "version": "0.1.1",
  "description": "A general plugin runtime for safe replacement.",
  "keywords": [
    "plugin-runtime",
    "plugins",
    "lifecycle",
    "dependency-injection",
    "hot-reload",
    "resource-management",
    "graceful-shutdown",
    "typescript"
  ],
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/neryva-lab/moult.git",
    "directory": "packages/runtime-core"
  },
  "bugs": {
    "url": "https://github.com/neryva-lab/moult/issues"
  },
  "homepage": "https://github.com/neryva-lab/moult#readme",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.cjs",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint . && prettier --check .",
    "test": "vitest run",
    "build": "tsdown",
    "api-extract": "api-extractor run --local",
    "mutation": "stryker run"
  },
  "dependencies": {
    "semver": "^7.8.5"
  },
  "devDependencies": {
    "@microsoft/api-extractor": "^7.59.0",
    "@stryker-mutator/core": "^10.0.0",
    "@stryker-mutator/vitest-runner": "^10.0.0",
    "@types/semver": "^7.8.0",
    "fast-check": "^4.9.0",
    "tsdown": "^0.22.14"
  }
}
